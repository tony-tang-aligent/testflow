# apps/web/.env.example
#
# Copy to .env.local and fill in real values. None of these are read with
# defaults/fallbacks in code - a missing one fails at runtime, not at build
# time, so it's easy to not notice one is missing until you hit that
# specific code path (exactly what happened with AUTH_SECRET).

# ---------- NextAuth (packages/auth) ----------
# Required by NextAuth v5 itself, read by naming convention - never referenced
# explicitly in our own config.ts, so it's easy to forget it exists at all.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# From the Azure AD app registration federated through Cognito
# (infra/lib/identity-stack.ts's UserPoolIdentityProviderOidc).
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
# IMPORTANT: this is COGNITO's own issuer, NOT Azure AD's - a common mix-up.
# NextAuth's Cognito provider only ever talks to Cognito's endpoints; Azure AD
# is wired in as an upstream IdP inside Cognito, never seen by NextAuth
# directly. Format: https://cognito-idp.{region}.amazonaws.com/{userPoolId}
# All three values are printed as CDK outputs after `cdk deploy` on
# IdentityStack (AuthCognitoIssuer, AuthCognitoId) - AUTH_COGNITO_SECRET isn't
# output directly (CDK can't safely print real secrets to CloudFormation
# outputs); retrieve it with:
#   aws cognito-idp describe-user-pool-client --user-pool-id <UserPoolId> \
#     --client-id <UserPoolClientId> --query 'UserPoolClient.ClientSecret'
AUTH_COGNITO_ISSUER=

# ---------- Aurora Serverless v2 / RDS Data API (packages/db) ----------
# From infra/lib/identity-stack.ts's IdentityStack outputs after deploy.
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=order_validator

# ---------- Flow engine (the original scopes-and-rules validator's HttpApi) ----------
# Server-only - never exposed to the browser (see lib/internalApiClient.ts).
# The shared secret must match infra/lib/api-stack.ts's internalAuthorizer
# secret, stored in Secrets Manager as order-validator/internal-api-key.
FLOW_ENGINE_API_URL=
INTERNAL_API_KEY=

# ---------- Flow builder (the new canvas/compiler system) ----------
# Public - the browser calls this directly (no auth wired yet on this API,
# see the flow-compiler-spec.md build's known limitations).
NEXT_PUBLIC_FLOW_BUILDER_API_URL=

# ---------- TEMPORARY dev bypass ----------
# Skips real NextAuth/Cognito/Azure AD AND real Postgres queries entirely, so
# you can exercise the UI before Aurora/Cognito are deployed or before Azure
# AD credentials exist. Double-gated (also requires NODE_ENV != production) -
# see packages/auth/src/devBypass.ts. Every page that uses it logs a loud
# console.warn so it's never silently in effect. Remove this once real
# credentials/infra are in place - not meant to be left on.
DEV_BYPASS_AUTH=true
# Which tenantId (from the ORIGINAL flow-engine's per-client stack) the
# bypassed /clients page redirects into - match whatever's actually deployed.
DEV_BYPASS_CLIENT_ID=TODO-current-tenant

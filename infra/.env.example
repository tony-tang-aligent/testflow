# infra/.env.example
#
# Copy to infra/.env and fill in real values before running `cdk deploy`.
# Loaded automatically by bin/app.ts (via dotenv) - no need to type these
# inline on the command line every time.
#
# These are DIFFERENT from apps/web/.env.local - this file is read by the CDK
# CLI process at synth/deploy time (building the Azure AD identity provider
# INTO Cognito); apps/web's file is read by the running Next.js app later, to
# talk to the Cognito/Aurora resources this deploy creates. Don't mix them up.

# From the Azure AD (Microsoft Entra ID) app registration - see the app
# registration setup steps discussed for AUTH_COGNITO_ID/SECRET/ISSUER in
# apps/web/.env.example (same underlying registration, different variable
# names here since these feed the CDK-side UserPoolIdentityProviderOidc
# construct, not NextAuth directly).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# e.g. https://login.microsoftonline.com/{tenantId}/v2.0
AZURE_AD_ISSUER_URL=
# The real deployed apps/web URL, e.g. https://main.xxxxx.amplifyapp.com - no
# trailing slash. Adds this alongside localhost as an allowed Cognito
# callback URL, so local dev and the deployed app both work without needing
# separate deploys when switching between them.
DEPLOYED_APP_URL=
